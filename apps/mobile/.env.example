# Backend base URL, no trailing slash. These values ship inside the app: no secrets.
#   iOS simulator:      http://localhost:8000
#   Android emulator:   http://10.0.2.2:8000
#   Phone on your Wi-Fi: http://<your Mac's LAN IP>:8000 (start the API with --host 0.0.0.0)
# Release builds require this and it must be https.
EXPO_PUBLIC_API_URL=http://localhost:8000

# 1 = run every screen on the local demo data (no backend). Development builds only; ignored in release.
EXPO_PUBLIC_USE_MOCKS=0

# 1 = open on the onboarding flow instead of Home (development builds only).
# EXPO_PUBLIC_START_AT_ONBOARDING=1

# Local test account (dev backend only): create it with
#   API_LOG=<file the API logs to> node scripts/seed-dev-student.mjs
# The API must run with AUTH_DEV_LOG_CODES=true so sign-up and new-device codes appear in its log.
#   phone:    9800000001
#   password: keoshaa-dev-123
